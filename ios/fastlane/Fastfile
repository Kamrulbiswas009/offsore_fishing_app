default_platform(:ios)

platform :ios do
  desc "Build and deploy Flutter iOS app to Apple TestFlight"
  lane :beta do
    UI.message("🚀 Starting TestFlight Deployment Lane...")

    # 1. Initialize App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. CI Keychain & Code Signing Certificate Setup
    keychain_name = "build_keychain"
    keychain_password = "ci_temp_password_123"

    if is_ci
      UI.message("🔐 Configuring CI Keychain and importing signing credentials...")
      
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      # Import Certificate (.p12) if provided
      if ENV["CERTIFICATE_PATH"] && File.exist?(ENV["CERTIFICATE_PATH"])
        import_certificate(
          certificate_path: ENV["CERTIFICATE_PATH"],
          certificate_password: ENV["P12_PASSWORD"] || "",
          keychain_name: keychain_name,
          keychain_password: keychain_password,
          allow_flexible_signing_policies: true
        )
      end

      # Install Provisioning Profile (.mobileprovision) if provided
      if ENV["PROVISIONING_PROFILE_PATH"] && File.exist?(ENV["PROVISIONING_PROFILE_PATH"])
        install_provisioning_profile(
          path: ENV["PROVISIONING_PROFILE_PATH"]
        )
      end

      # Configure CI environment signing
      setup_ci(
        provider: "github",
        force: true
      )
    end

    # 3. Determine Build Number
    begin
      current_build_number = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "com.onthebite.app.ios"
      )
      new_build_number = current_build_number + 1
      UI.message("📈 Fetched TestFlight build number: #{current_build_number}. Next build number: #{new_build_number}")
    rescue => e
      UI.important("⚠️ Could not fetch latest build number from TestFlight: #{e.message}")
      new_build_number = (ENV["BUILD_NUMBER"] || "1").to_i
      UI.message("📈 Using fallback build number: #{new_build_number}")
    end

    # 4. Build Flutter iOS IPA
    UI.message("🔨 Building Flutter Release IPA...")
    sh("cd ../.. && flutter build ipa --release --build-number=#{new_build_number} --export-options-plist=ios/ExportOptions.plist")

    # Locate output IPA file
    ipa_path = Dir["../../build/ios/ipa/*.ipa"].first
    unless ipa_path && File.exist?(ipa_path)
      UI.user_error!("❌ IPA file not found in build/ios/ipa/. Build failed.")
    end

    UI.message("📦 Found IPA at: #{ipa_path}")

    # 5. Upload to Apple TestFlight
    UI.message("📤 Uploading IPA to Apple TestFlight...")
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.onthebite.app.ios",
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    # 6. Cleanup CI Keychain
    if is_ci && File.exist?(File.expand_path("~/Library/Keychains/#{keychain_name}-db"))
      delete_keychain(name: keychain_name)
    end

    UI.success("🎉 Successfully deployed build ##{new_build_number} to TestFlight!")
  end
end
